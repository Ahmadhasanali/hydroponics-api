# Demo portfolio dengan SQLite — tanpa Postgres, tanpa simpan data user permanen.
# Copy ke .env.production lalu sesuaikan APP_KEY / URL.
APP_NAME=Hydroponics-Farm
APP_ENV=production
APP_DEBUG=false
APP_URL=https://demo-api.kamu.id
FRONTEND_URL=https://demo.kamu.id

# SQLite ephemeral
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/demo.sqlite
# Kosongkan agar tidak dipakai
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Demo mode: blokir register/reset-password, seed akun bersama, reset tiap jam via scheduler
DEMO_MODE=true
DEMO_EMAIL=demo@hydrofarm.id
DEMO_PASSWORD=demo123456

# Matikan/disample-kan integrasi berbayar di demo
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MAIL_MAILER=array
FCM_SERVICE_ACCOUNT_JSON=
