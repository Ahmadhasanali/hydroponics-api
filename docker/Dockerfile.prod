# syntax=docker/dockerfile:1

# ---------- Stage 1: frontend assets (Node) ----------
FROM node:22-alpine AS assets

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ---------- Stage 2: PHP dependencies (Composer) ----------
FROM composer:2 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --prefer-dist \
    --no-interaction

COPY . .
RUN composer install \
    --no-dev \
    --prefer-dist \
    --no-interaction \
    && composer dump-autoload --optimize

# ---------- Stage 3: runtime (PHP-FPM + Nginx + Supervisor) ----------
FROM php:8.5-fpm

ARG WWWGROUP=1000
ARG WWWUSER=1000

ENV TZ=UTC \
    DEBIAN_FRONTEND=noninteractive \
    PHP_OPCACHE_ENABLE=1

# System packages
RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx \
        supervisor \
        ca-certificates \
        curl \
        git \
        zip \
        unzip \
        libpq-dev \
        libpng-dev \
        libjpeg-dev \
        libwebp-dev \
        libfreetype6-dev \
        libicu-dev \
        libonig-dev \
        libzip-dev \
        libxml2-dev \
        libcurl4-openssl-dev \
        postgresql-client \
        cron \
    && rm -rf /var/lib/apt/lists/*

# PHP extensions (installed sequentially to avoid parallel build races).
# Note: opcache is intentionally omitted — Zend OPcache ships built-in
# with PHP 8.5 and is enabled via the opcache.ini config below.
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo_pgsql \
    && docker-php-ext-install pgsql \
    && docker-php-ext-install gd \
    && docker-php-ext-install intl \
    && docker-php-ext-install mbstring \
    && docker-php-ext-install zip \
    && docker-php-ext-install bcmath \
    && docker-php-ext-install pcntl

# Note: redis extension intentionally omitted — the app uses database
# drivers for cache/session/queue, so redis is not required at runtime.

# Composer binary
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Nginx + PHP-FPM + Supervisor configs
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/php.ini /usr/local/etc/php/conf.d/99-app.ini
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Application
WORKDIR /var/www/html
COPY --from=vendor --chown=www-data:www-data /app /var/www/html
COPY --from=assets --chown=www-data:www-data /app/public/build /var/www/html/public/build

# Writable runtime directories
RUN mkdir -p storage/framework/{sessions,views,cache} storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache public \
    && chmod -R ug+rw storage bootstrap/cache

# Create app user to match host UID/GID (rootless docker)
RUN groupadd --force --gid "$WWWGROUP" app \
    && useradd --no-log-init --create-home --shell /bin/bash --uid "$WWWUSER" --gid "$WWWGROUP" app \
    && usermod -aG www-data app

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://localhost/up || exit 1

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
